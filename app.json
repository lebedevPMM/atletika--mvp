{
  "expo": {
    "name": "Атлетика+",
    "slug": "atletika",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "atletika",
    "userInterfaceStyle": "automatic",
    "ios": {
      "newArchEnabled": true,
      "supportsTablet": false,
      "bundleIdentifier": "com.atletika.app"
    },
    "android": {
      "newArchEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.atletika.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/atletika--mvp"
    }
  }
}
